# Cấu hình OpenSSL riêng cho tiến trình kết nối SQL 2008 R2 chưa vá TLS 1.2.
# Chỉ dùng qua biến môi trường OPENSSL_CONF cho đúng tiến trình đó, KHÔNG áp toàn hệ thống.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
